{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EIDF | Eclipse (JTAG + UART)",
      "type": "gdbtarget",
      "request": "attach",

      "cwd": "${workspaceFolder}",

      "initCommands": [
        "set remotetimeout 30",
        "set mem inaccessible-by-default off",
        "monitor reset halt",
        "maintenance flush register-cache"
      ]
    }
  ]
}
